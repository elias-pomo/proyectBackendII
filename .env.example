# Servidor
PORT=8080
NODE_ENV=development

# Autenticación (obligatorias)
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=1h

# Base de datos (obligatorias). Local: mongodb://127.0.0.1:27017
MONGO_URL=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net
DB_NAME=ringo_box_gym

# Email (opcionales: si falta alguna, la API no envía emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
