<form id="loginForm" novalidate>
    <div>
        <h1 class="display display-md">INGRESAR</h1>
        <p class="muted" style="margin-top: 14px">¿Primera vez? <a href="/registro">Creá tu cuenta</a></p>
    </div>

    <div id="message" class="alert" role="alert"></div>

    <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" inputmode="email" required>
    </div>
    <div class="field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
    </div>
    <button type="submit" class="btn btn-lg btn-block">Entrar</button>
</form>

<script type="module" src="/js/login.js"></script>
